---
import config from '../config';
---

<div class="bio">
  <img class="avatar" src={config.userAvatar} alt={config.userName} />
  <p class="text"><strong>{config.userName}</strong></p>
  <div class="links">
    <a href={`https://twitter.com/${config.userTwitter}`} target="_blank" rel="noopener noreferrer" aria-label="Twitter">Twitter</a>
    <a href={`https://github.com/${config.userGitHub}`} target="_blank" rel="noopener noreferrer" aria-label="GitHub">GitHub</a>
    <a href={`https://linkedin.com/in/${config.userLinkedIn}`} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">LinkedIn</a>
  </div>
</div>

<style lang="scss">
  .bio::after {
    content: '';
    display: block;
    clear: both;
  }

  .avatar {
    border-radius: 50%;
    width: 70px;
    float: left;
    margin: 5px 20px;
  }

  a {
    color: black;
    margin-right: 10px;
  }

  .text {
    margin-bottom: 0;
  }

  .links {
    font-size: 0.85rem;
  }
</style>
