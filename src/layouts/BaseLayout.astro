---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import config from '../config';
import '../styles.scss';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const { title = config.siteTitle, description = config.siteDescription, canonicalPath = '/' } = Astro.props;
const pageTitle = title === config.siteTitle ? title : `${title} | ${config.siteTitle}`;
const canonicalUrl = new URL(canonicalPath, config.siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={config.themeColor} />
    <link rel="icon" href="/logos/logo-48.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={config.siteTitle} href={config.siteRss} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
    {config.googleAnalyticsID && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${config.googleAnalyticsID}`}></script>
    )}
    {config.googleAnalyticsID && (
      <script is:inline define:vars={{ id: config.googleAnalyticsID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', id);
      </script>
    )}
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
